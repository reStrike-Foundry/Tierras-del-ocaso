---
layout: null
---
{%- assign docs = site.articles | concat: site.expeditions | concat: site.records | where_exp: "d", "d.nav != false" -%}
[
{%- for d in docs %}
  {"title": {{ d.title | jsonify }}, "url": {{ d.url | relative_url | jsonify }}, "summary": {{ d.summary | default: "" | jsonify }}, "category": {{ d.category | default: "" | jsonify }}, "text": {{ d.content | markdownify | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
